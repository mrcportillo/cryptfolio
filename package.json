{
  "name": "cyptfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:ledger-postgres": "CRYPTFOLIO_REQUIRE_LEDGER_TEST_DATABASE=1 node --test test/opening-balances-postgres.test.mjs",
    "test:transactions-postgres": "CRYPTFOLIO_REQUIRE_LEDGER_TEST_DATABASE=1 node --experimental-strip-types --test test/portfolio-transactions-postgres.test.mjs",
    "test:legacy-postgres": "CRYPTFOLIO_REQUIRE_LEDGER_TEST_DATABASE=1 node --experimental-strip-types --test test/legacy-compatibility-postgres.test.mjs",
    "audit": "pnpm audit --prod",
    "ledger:opening-balances": "node scripts/portfolio-ledger/opening-balances.mjs",
    "valuation:snapshot": "node --experimental-strip-types scripts/portfolio-valuation/snapshots.mjs",
    "test:valuation-postgres": "CRYPTFOLIO_REQUIRE_VALUATION_TEST_DATABASE=1 node --experimental-strip-types --test test/portfolio-valuation-postgres.test.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.25.0",
    "@prisma/client": "^5.10.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.0.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "next": "^15.5.24",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.9.2",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.5.23",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "prisma": "^5.10.2",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.3"
  }
}
