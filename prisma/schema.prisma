generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id              String           @id
  name            String
  email           String           @unique
  ledgerAdoptedAt DateTime?
  userAssets      UserAsset[]
  portfolioEvents PortfolioEvent[]
}

model UserAsset {
  id                     String          @id @default(cuid())
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  assetId                String
  assetName              String
  amount                 Float
  date                   DateTime        @default(now())
  archivedAt             DateTime?
  ledgerInitialAssetName String?         @db.VarChar(80)
  assetArchive           AssetArchive[]
  movements              AssetMovement[]
  openingEvent           PortfolioEvent?

  @@unique([id, userId])
  @@index([userId, date])
  @@index([userId, archivedAt, date])
  @@index([assetId])
}

model AssetArchive {
  id          String    @id @default(cuid())
  userAsset   UserAsset @relation(fields: [userAssetId], references: [id], onDelete: Cascade)
  userAssetId String
  amount      Float
  date        DateTime

  @@index([userAssetId, date])
}

enum PortfolioEventKind {
  OPENING_BALANCE
  BUY
  SELL
  TRANSFER_IN
  TRANSFER_OUT
  SWAP
  FEE
  REVERSAL
}

enum AssetMovementRole {
  PRINCIPAL
  FEE
}

model PortfolioEvent {
  id                    String             @id @default(cuid())
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId                String
  kind                  PortfolioEventKind
  occurredAt            DateTime
  actualValueUsd        Decimal?           @db.Decimal(65, 30)
  externalFlowUsd       Decimal?           @db.Decimal(65, 30)
  feeUsd                Decimal?           @db.Decimal(65, 30)
  note                  String?            @db.VarChar(500)
  idempotencyKey        String             @db.VarChar(160)
  openingForUserAsset   UserAsset?         @relation(fields: [openingForUserAssetId, userId], references: [id, userId], onDelete: Restrict)
  openingForUserAssetId String?
  reversalOf            PortfolioEvent?    @relation("PortfolioEventReversal", fields: [reversalOfEventId, userId], references: [id, userId], onDelete: Restrict)
  reversalOfEventId     String?
  reversedBy            PortfolioEvent?    @relation("PortfolioEventReversal")
  replacementFor        PortfolioEvent?    @relation("PortfolioEventReplacement", fields: [replacementForEventId, userId], references: [id, userId], onDelete: Restrict)
  replacementForEventId String?
  replacedBy            PortfolioEvent?    @relation("PortfolioEventReplacement")
  movements             AssetMovement[]
  createdAt             DateTime           @default(now())

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@unique([openingForUserAssetId, userId])
  @@unique([reversalOfEventId, userId])
  @@unique([replacementForEventId, userId])
  @@index([userId, occurredAt, id])
}

model AssetMovement {
  id               String            @id @default(cuid())
  userId           String
  portfolioEvent   PortfolioEvent    @relation(fields: [portfolioEventId, userId], references: [id, userId], onDelete: Restrict)
  portfolioEventId String
  userAsset        UserAsset         @relation(fields: [userAssetId, userId], references: [id, userId], onDelete: Restrict)
  userAssetId      String
  role             AssetMovementRole @default(PRINCIPAL)
  quantityDelta    Decimal           @db.Decimal(65, 30)
  unitPriceUsd     Decimal?          @db.Decimal(65, 30)
  priceEstimated   Boolean           @default(false)
  createdAt        DateTime          @default(now())

  @@unique([portfolioEventId, userAssetId, role])
  @@index([userId, userAssetId, createdAt, id])
  @@index([userId, portfolioEventId])
}
