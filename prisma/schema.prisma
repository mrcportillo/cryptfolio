generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
    id String @id
    name String
    email String @unique
    userAssets UserAsset[]
}

model UserAsset {
    id String @default(cuid()) @id
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String
    assetId String
    assetName String
    amount Float
    date DateTime @default(now())
    assetArchive AssetArchive[]

    @@index([userId, date])
    @@index([assetId])
}

model AssetArchive {
    id String @default(cuid()) @id
    userAsset UserAsset @relation(fields: [userAssetId], references: [id], onDelete: Cascade)
    userAssetId String
    amount Float
    date DateTime

    @@index([userAssetId, date])
}
